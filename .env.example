NODE_ENV=production
HOST=0.0.0.0
PORT=10000

# URL pubblico completo dell'applicazione
APP_BASE_URL=https://example.onrender.com

# Directory persistente per SQLite e outbox locale
DATA_DIR=/var/data

# Opzionale: percorsi espliciti
# DB_PATH=/var/data/simulatore.sqlite
# OUTBOX_DIR=/var/data/outbox

# Email reali tramite Resend
# Se non imposti questi valori, l'app resta in modalita local_outbox
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM="TOLC-I, il simulatore" <noreply@tuodominio.it>
